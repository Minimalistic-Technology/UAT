{
  "name": "ddtec-mail-scheduler",
  "version": "1.0.0",
  "description": "Standalone SQLite-backed email scheduler for DDTEC (Node.js + Nodemailer + node-cron)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.19.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.9",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
