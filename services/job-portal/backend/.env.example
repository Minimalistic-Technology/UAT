# Server Configuration
PORT=5000
NODE_ENV=production

# Database
# For production, use MongoDB Atlas or your cloud MongoDB instance
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Configuration
# IMPORTANT: Generate a strong, unique secret key for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# OAuth - Google (Optional)
# Get credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary (For file/image uploads)
# Get credentials from https://cloudinary.com/
CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Twilio (SMS OTP - Optional)
# Get credentials from https://www.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Email Configuration (SMTP) - REQUIRED FOR PASSWORD RESET
# Gmail Setup:
# 1. Go to your Google Account settings
# 2. Enable 2-Factor Authentication
# 3. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 4. Use this app password (not your regular password) in EMAIL_PASS
# 
# Alternative SMTP Providers (if not using Gmail):
# - SendGrid: smtp.sendgrid.net (Port 587)
# - Mailgun: smtp.mailgun.org (Port 587)
# - AWS SES: email-smtp.region.amazonaws.com (Port 587)

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Frontend URL
# For production on Render, this will be your frontend deployment URL
# Example: https://your-app.onrender.com
CLIENT_URL=http://localhost:3000

# ============================================================
# RENDER DEPLOYMENT CHECKLIST:
# ============================================================
# 1. Create a new Web Service on Render
# 2. Connect your GitHub repository
# 3. Set Build Command: npm install && npm run build
# 4. Set Start Command: npm start
# 5. Add all the above environment variables in Render's Environment section
# 6. Make sure to use strong, unique values for JWT_SECRET
# 7. Use MongoDB Atlas for cloud database (not localhost)
# 8. Set CLIENT_URL to your frontend's deployed URL
# 9. For Gmail, use an App Password (see instructions above)
# 10. Set NODE_ENV=production
