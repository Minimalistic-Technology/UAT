generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------- ENUMS -------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum WorkType {
  REMOTE
  HYBRID
  ON_SITE
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  INR
  USD
  EUR
  GBP
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_501_1000
  SIZE_1000_PLUS
}

// -------------------- MODEL -------------------------

model Avatar {
  id       String @id @default(uuid())
  url      String
  publicId String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id           String  @id @default(uuid())
  url          String
  publicId     String
  originalName String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  atsScore AtsScore?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AtsScore {
  id String @id @default(uuid())

  overallScore    Int
  sectionScore    Int
  formattingScore Int
  keywordScore    Int
  contentScore    Int

  sectionsFound   String[]
  sectionsMissing String[]
  matchedKeywords String[]

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id      String  @id @default(uuid())
  city    String?
  state   String?
  country String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id String @id @default(uuid())

  title    String
  company  String
  workType WorkType?
  location String?

  startDate DateTime
  endDate   DateTime?
  current   Boolean   @default(false)

  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Education {
  id String @id @default(uuid())

  degree         String
  institution    String
  graduationYear Int
  fieldOfStudy   String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  email     String     @unique
  password  String?
  phone     String?
  role      GlobalRole @default(USER)

  // Avatar
  avatar Avatar?

  // Resume
  resume Resume?

  skills    String[]
  languages String[]

  experiences Experience[]
  educations  Education[]

  // Location
  location Location?

  // OAuth
  googleId String? @unique

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Password Reset
  resetPasswordOtp     String?
  resetPasswordExpires DateTime?

  // Testimonials
  testimonials Testimonial[]

  // Company
  company Company?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model TempUser {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email    String @unique
  password String

  phone String?

  role GlobalRole @default(USER)

  otp       String
  expiresAt DateTime

  isEmployer Boolean @default(false)

  companyName String?
  companyRole String?
  industry    String?

  resendAttempts Int @default(0)

  blockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // We'll schedule a cron job to delete the data for those user who just signedIn but never verified
  @@index([expiresAt])
}

model Testimonial {
  id      String @id @default(uuid())
  content String
  rating  Int    @default(5)

  authorName    String
  authorRole    String?
  authorCompany String?

  status TestimonialStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Logo {
  id       String @id @default(uuid())
  url      String
  publicId String

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyLocation {
  id String @id @default(uuid())

  address String?
  city    String?
  state   String?
  country String?
  zipCode String?

  isHeadquarters Boolean @default(false)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([city, country])
}

model Company {
  id String @id @default(uuid())

  name        String
  slug        String  @unique
  description String?

  website     String?
  industry    String
  companySize CompanySize       @default(SIZE_1_10)
  locations   CompanyLocation[]

  socialLinks Json?

  // Owner
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  logo Logo?

  // subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
  @@index([isVerified])
}

model Plan {
  id String @id @default(uuid())

  name        String  @unique
  description String?

  /// Store the price in the smallest currency unit
  /// Example: ₹10.89 -> 1089
  price    Int
  currency Currency @default(INR)

  // Subscription lifecycle: how long the PLAN ITSELF is active
  subscriptionDurationDays Int

  // Usage limits: what the plan allows while active
  maxActiveJobPosts Int // -1 means unlimited
  maxTeamMembers    Int @default(0) // -1 means unlimited

  // Per-job behavior: applies to EACH job posted under this plan
  jobPostValidityDays Int
  allowResumeDownload Boolean

  features String[]

  isDefault    Boolean @default(false)
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}
