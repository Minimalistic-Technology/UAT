generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------- ENUMS -------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum WorkType {
  REMOTE
  HYBRID
  ON_SITE
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  INR
  USD
  EUR
  GBP
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_501_1000
  SIZE_1000_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  DEPLETED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum CouponType {
  PERCENTAGE
  AMOUNT
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  GST_CERTIFICATE
  COMPANY_PAN
  INCORPORATION_CERTIFICATE
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
}

enum CompanyRole {
  OWNER
  HR
}

enum DraftType {
  JOB
  INTERNSHIP
}

// -------------------- MODEL -------------------------

model Avatar {
  id       String @id @default(uuid())
  url      String
  publicId String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id           String  @id @default(uuid())
  url          String
  publicId     String
  originalName String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  atsScore AtsScore?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AtsScore {
  id String @id @default(uuid())

  overallScore    Int
  sectionScore    Int
  formattingScore Int
  keywordScore    Int
  contentScore    Int

  sectionsFound   String[]
  sectionsMissing String[]
  matchedKeywords String[]

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id      String  @id @default(uuid())
  city    String?
  state   String?
  country String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id String @id @default(uuid())

  title    String
  company  String
  workType WorkType?
  location String?

  startDate DateTime
  endDate   DateTime?
  current   Boolean   @default(false)

  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Education {
  id String @id @default(uuid())

  degree         String
  institution    String
  graduationYear Int
  fieldOfStudy   String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  email     String     @unique
  password  String?
  phone     String?
  role      GlobalRole @default(USER)

  // Avatar
  avatar Avatar?

  // Resume
  resume Resume?

  skills    String[]
  languages String[]

  experiences Experience[]
  educations  Education[]

  // Location
  location Location?

  // OAuth
  googleId String? @unique

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Password Reset
  resetPasswordOtp     String?
  resetPasswordExpires DateTime?

  // Testimonials
  testimonials Testimonial[]

  // Payments
  payments Payment[]

  // Coupon usage
  couponUsages CouponUsage[]

  // Company
  company Company?

  kycSubmissions  KYC[] @relation("KycSubmitter")
  kycReviewsGiven KYC[] @relation("KycReviewer")

  companyMembers  CompanyMember[]

  drafts Draft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model TempUser {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email    String @unique
  password String

  phone String?

  role GlobalRole @default(USER)

  otp       String
  expiresAt DateTime

  isEmployer Boolean @default(false)

  companyName String?
  companyRole String?
  industry    String?

  resendAttempts Int @default(0)

  blockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // We'll schedule a cron job to delete the data for those user who just signedIn but never verified
  @@index([expiresAt])
}

model Testimonial {
  id      String @id @default(uuid())
  content String
  rating  Int    @default(5)

  authorName    String
  authorRole    String?
  authorCompany String?

  status TestimonialStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model CompanyLocation {
  id String @id @default(uuid())

  address String?
  city    String?
  state   String?
  country String?
  zipCode String?

  isHeadquarters Boolean @default(false)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([city, country])
}

model Company {
  id String @id @default(uuid())

  name        String
  slug        String  @unique
  description String?

  website     String?
  industry    String
  companySize CompanySize       @default(SIZE_1_10)
  locations   CompanyLocation[]

  socialLinks Json?

  // Owner
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  logoId String?       @unique
  logo   StorageAsset? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  subscriptions Subscription[]

  kycSubmissions KYC[]

  members CompanyMember[]

  drafts Draft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
  @@index([isVerified])
}

model Plan {
  id String @id @default(uuid())

  name        String  @unique
  description String?

  /// Store the price in the smallest currency unit
  /// Example: ₹10.89 -> 1089
  price    Int
  currency Currency @default(INR)

  // Subscription lifecycle: how long the PLAN ITSELF is active
  subscriptionDurationDays Int

  // Usage limits: what the plan allows while active
  maxActiveJobPosts Int // -1 means unlimited
  maxTeamMembers    Int @default(0) // -1 means unlimited

  // Per-job behavior: applies to EACH job posted under this plan
  jobPostValidityDays Int
  allowResumeDownload Boolean

  features String[]

  subscriptions Subscription[]

  isDefault    Boolean @default(false)
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model Subscription {
  id String @id @default(uuid())

  // Employer
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Plan
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // Payment
  orderId    String? @unique
  paymentRef String?

  // Usage
  postsRemaining    Int
  totalPostsGranted Int

  // Dates
  startDate    DateTime  @default(now())
  expiryDate   DateTime
  cancelledAt  DateTime?
  lastBilledAt DateTime?

  // Status
  status SubscriptionStatus @default(ACTIVE)

  // Payment
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([expiryDate])
}

model PaymentWebhookEvent {
  id String @id @default(uuid())

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  eventId String @unique
  type    String

  payload Json

  processedAt DateTime?

  receivedAt DateTime @default(now())

  @@index([paymentId])
  @@index([type])
}

model Refund {
  id String @id @default(uuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  razorpayRefundId String       @unique
  amount           Int
  reason           String?
  status           RefundStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
}

model Payment {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  amount   Int
  currency Currency @default(INR)

  razorpayOrderId   String  @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  webhookEvents PaymentWebhookEvent[]

  metadata Json?

  method PaymentMethod?

  failureReason String?

  refunds Refund[]

  status PaymentStatus @default(CREATED)

  receipt String?

  capturedAt DateTime?

  couponUsage CouponUsage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([subscriptionId])
}

model Coupon {
  id String @id @default(uuid())

  code String @unique

  type  CouponType
  value Int

  isActive Boolean @default(true)

  expiryDate DateTime?

  maxUses Int?

  usageCount Int @default(0)

  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponUsage {
  id String @id @default(uuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  discountApplied Int

  usedAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

model KYC {
  id String @id @default(uuid())

  userId String
  user   User   @relation("KycSubmitter", fields: [userId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  companyDocumentId   String
  companyDocument     StorageAsset @relation("CompanyDocument", fields: [companyDocumentId], references: [id], onDelete: Cascade)
  companyDocumentType DocumentType

  personalDocumentId   String
  personalDocument     StorageAsset @relation("PersonalDocument", fields: [personalDocumentId], references: [id], onDelete: Cascade)
  personalDocumentType DocumentType

  status KycStatus @default(PENDING)

  rejectionReason String?

  reviewedById String?
  reviewedBy   User?     @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  isLatest Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([userId, isLatest])
  @@index([companyDocumentId])
  @@index([personalDocumentId])
}

model StorageAsset {
  id String @id @default(uuid())

  url      String
  publicId String

  mimeType  String?
  sizeBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company?
  companyDocumentFor  KYC[]    @relation("CompanyDocument")
  personalDocumentFor KYC[]    @relation("PersonalDocument")
}

model CompanyMember {
  id String @id @default(uuid())

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role   CompanyRole
  isActive   Boolean     @default(true)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

   @@unique([userId, companyId])
}

model Draft {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  postedById String
  postedBy   User   @relation(fields: [postedById], references: [id], onDelete: Cascade)

  type DraftType

  formData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([postedById])
}