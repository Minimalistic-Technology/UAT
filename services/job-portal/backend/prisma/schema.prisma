generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------- ENUMS -------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum WorkType {
  REMOTE
  HYBRID
  ON_SITE
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

// -------------------- MODEL -------------------------

model Avatar {
  id       String @id @default(uuid())
  url      String
  publicId String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id           String  @id @default(uuid())
  url          String
  publicId     String
  originalName String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  atsScore AtsScore?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AtsScore {
  id String @id @default(uuid())

  overallScore    Int
  sectionScore    Int
  formattingScore Int
  keywordScore    Int
  contentScore    Int

  sectionsFound   String[]
  sectionsMissing String[]
  matchedKeywords String[]

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id      String  @id @default(uuid())
  city    String?
  state   String?
  country String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id String @id @default(uuid())

  title    String
  company  String
  workType WorkType?
  location String?

  startDate DateTime
  endDate   DateTime?
  current   Boolean   @default(false)

  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Education {
  id String @id @default(uuid())

  degree         String
  institution    String
  graduationYear Int
  fieldOfStudy   String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  email     String     @unique
  password  String?
  phone     String?
  role      GlobalRole @default(USER)

  // Avatar
  avatar Avatar?

  // Resume
  resume Resume?

  skills    String[]
  languages String[]

  experiences Experience[]
  educations  Education[]

  // Location
  location Location?

  // OAuth
  googleId String? @unique

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Password Reset
  resetPasswordOtp     String?
  resetPasswordExpires DateTime?

  // Testimonials
  testimonials Testimonial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model TempUser {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email    String @unique
  password String

  phone String?

  role GlobalRole @default(USER)

  otp       String
  expiresAt DateTime

  isEmployer Boolean @default(false)

  companyName String?
  companyRole String?
  industry    String?

  resendAttempts Int @default(0)

  blockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // We'll schedule a cron job to delete the data for those user who just signedIn but never verified
  @@index([expiresAt])
}

model Testimonial {
  id      String @id @default(uuid())
  content String
  rating  Int    @default(5)

  authorName    String
  authorRole    String?
  authorCompany String?

  status TestimonialStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
