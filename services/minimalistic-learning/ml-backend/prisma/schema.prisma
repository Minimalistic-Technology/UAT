generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  @@index([email])
  @@index([role])
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  email         String         @unique
  password      String
  role          String         @default("user")
  isVerified    Boolean        @default(false)
  otp           String?
  otpExpires    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  comments      Comment[]
  notifications Notification[]
  posts         Post[]
  tokens        Token[]
}

model Post {
  @@index([slug])
  @@index([authorId])
  @@index([published])
  @@index([status])
  @@index([createdAt])
  id          String   @id @default(cuid())
  title       String   @default("Untitled Story")
  slug        String   @unique
  content     String   @default("")
  description String?
  coverImage  String?  // JSON stored as string
  readTime    Int      @default(0)
  tags        String   @default("[]") // JSON array stored as string
  authorId    String
  published   Boolean  @default(false)
  status      String   @default("pending")
  category    String   @default("Uncategorized")
  viewCount   Int      @default(0)
  viewedBy    String   @default("[]") // JSON array stored as string
  likes       String   @default("[]") // JSON array stored as string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    Comment[]
  author      User     @relation(fields: [authorId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  parentId  String?
  likes     String   @default("[]") // JSON array stored as string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  title       String
  message     String
  type        String   @default("general")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  recipient   User     @relation(fields: [recipientId], references: [id])
}

model PendingUser {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String?
  email         String   @unique
  password      String?
  role          String   @default("user")
  otp           String
  otpExpires    DateTime
  createdAt     DateTime @default(now())
}

model Token {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  type      String
  expiresAt DateTime
  metadata  String?  // JSON stored as string
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model SiteSetting {
  id                 String   @id @default(cuid())
  key                String   @unique @default("global")
  autoApprovePost    Boolean  @default(true)
  resourceHubEnabled Boolean  @default(true)
  maintenanceMode    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AllowedRoute {
  id        String   @id @default(cuid())
  path      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RoutePermission {
  id          String   @id @default(cuid())
  path        String
  method      String?
  role        String   @default("user")
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([path, method, role])
}

model SiteContent {
  id        String   @id @default(cuid())
  page      String
  section   String
  content   String   // JSON stored as string
  updatedAt DateTime @updatedAt

  @@unique([page, section])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  image     String?
  github    String?
  twitter   String?
  linkedin  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
