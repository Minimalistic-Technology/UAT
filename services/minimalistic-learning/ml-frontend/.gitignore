# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Testing ─────────────────────────────────────────
/coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# ── Next.js ─────────────────────────────────────────
/.next/
/out/

# ── Production Build ─────────────────────────────────
/build

# ── Environment & Secrets (NEVER commit!) ────────────
.env
.env.*
!.env.example

# ── Debug Logs ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── OS Files ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Vercel ──────────────────────────────────────────
.vercel

# ── TypeScript ──────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
